# Supabase is retained only for the one-time import and optional off-device backup.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SERVICE_ROLE_KEY=

# Used by the hosted fallback only. The local server stores its own secret in SQLite.
SESSION_SECRET=replace-with-at-least-32-random-characters

# Local Server configuration. SQLite defaults to ./data/center.sqlite.
CENTER_HOST=0.0.0.0
CENTER_PORT=3000
CENTER_DATA_DIR=./data
# Optional first-start bootstrap. Prefer `npm run local:setup` instead of keeping a PIN here.
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PIN=
