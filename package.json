{
  "name": "center-plus-management",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "local:start": "node local-server/server.mjs",
    "local:setup": "node local-server/setup.mjs",
    "local:import": "node local-server/import-json.mjs",
    "local:import-supabase": "node --env-file-if-exists=.env local-server/import-supabase.mjs",
    "local:verify-supabase": "node --env-file-if-exists=.env local-server/verify-supabase-import.mjs",
    "local:backup": "node local-server/backup.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/local-server.test.mjs tests/whatsapp.test.ts",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern promo-video"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "write-excel-file": "^3.0.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
